# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- PostgreSQL (source of truth) ---
DATABASE_URL=postgres://ridex:ridex_password@localhost:5432/ridex
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000

# --- Redis (hot/ephemeral data: geo, cache, locks, queues, sessions) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Payments (mock by default; swap to stripe later) ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Notifications / BullMQ (Phase 13) ---
NOTIFICATION_BACKOFF_MS=1000
NOTIFICATION_WORKER_CONCURRENCY=5
# true = run the worker inside the API process (handy in dev). In production run `npm run worker` separately.
START_WORKER=false
OFFER_ACCEPTANCE_TTL_MS=172800000
RENTAL_PAYMENT_HOLD_MS=900000

# --- Earnings (Phase 17) ---
PLATFORM_COMMISSION_PERCENT=20
RENTAL_COMMISSION_PERCENT=10
MIN_PAYOUT_AMOUNT=100

# --- Surge pricing ---
SURGE_ENABLED=true
SURGE_RADIUS_METERS=5000
# minRatio:multiplier pairs (demand per available driver). Empty = defaults 1.5:1.2,2.5:1.5,4:2
SURGE_TIERS=

# --- Observability (Phase 21) ---
# Bearer token for GET /metrics (>= 16 chars). Unset: open in dev, DISABLED in production.
METRICS_TOKEN=
# Seconds-worth of ms to keep /ready at 503 before closing the server on SIGTERM (set ~5000 behind a load balancer)
SHUTDOWN_DRAIN_MS=0
AUTH_RATE_LIMIT_MAX=10

# --- Voice assistant ---
# Optional. With a key the assistant answers in any supported language via Claude; without one it reads the built-in guide (English + Hindi).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_TIMEOUT_MS=15000
ASSISTANT_RATE_LIMIT_MAX=20
